local fpsBoostEnabled = false
local oldEffects = {}
local oldMaterials = {}
local oldShadows = {}
local oldMaterialQuality = UserSettings():GetService("UserGameSettings").SavedQualityLevel
local function desactivarEfectos()
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("PostEffect") or effect:IsA("BlurEffect") or effect:IsA("BloomEffect") or effect:IsA("DepthOfFieldEffect") or effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") then
            oldEffects[effect] = effect.Enabled
            effect.Enabled = false
        end
    end
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BasePart") then
            oldMaterials[desc] = desc.Material
            oldShadows[desc] = desc.CastShadow
            desc.Material = Enum.Material.SmoothPlastic
            desc.CastShadow = false
        end
    end
    UserSettings():GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
    Lighting.GlobalShadows = false
    Lighting.ShadowSoftness = 1
end
local function restaurarEfectos()
    for effect, enabled in pairs(oldEffects) do
        if effect and effect.Parent then
            effect.Enabled = enabled
        end
    end
    oldEffects = {}
    for part, material in pairs(oldMaterials) do
        if part and part.Parent then
            part.Material = material
        end
    end
    oldMaterials = {}
    for part, castShadow in pairs(oldShadows) do
        if part and part.Parent then
            part.CastShadow = castShadow
        end
    end
    oldShadows = {}
    UserSettings():GetService("UserGameSettings").SavedQualityLevel = oldMaterialQuality
    Lighting.GlobalShadows = oldLighting.GlobalShadows
    Lighting.ShadowSoftness = oldLighting.ShadowSoftness
end
