local airWalkEnabled = false
local airPart = nil
local airWalkConnection
local function createAirPart()
    if airPart then
        airPart:Destroy()
    end
    airPart = Instance.new("Part")
    airPart.Name = "Airwalk"
    airPart.Size = Vector3.new(7, 2, 3)
    airPart.Transparency = 1
    airPart.Anchored = true
    airPart.CanCollide = false
    airPart.Parent = workspace
end
local function startAirWalk()
    createAirPart()
    airWalkConnection = RunService.RenderStepped:Connect(function()
        if not airWalkEnabled then
            return
        end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and airPart then
            airPart.CFrame = hrp.CFrame + Vector3.new(0, -4, 0)
            airPart.CanCollide = true
        end
    end)
end
local function stopAirWalk()
    if airWalkConnection then
        airWalkConnection:Disconnect()
        airWalkConnection = nil
    end
    if airPart then
        airPart:Destroy()
        airPart = nil
    end
end
DiversionTab:Toggle({
    Title = "Air Walk",
    Default = false,
    Callback = function(value)
        airWalkEnabled = value
        if value then
            startAirWalk()
        else
            stopAirWalk()
        end
    end
})
local FlipCooldown = false
local frontFlipGui = nil
local function FortniteFlips()
    if FlipCooldown then
        return
    end
    FlipCooldown = true
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    local animate = character and character:FindFirstChild("Animate")
    if not hrp or not humanoid then
        FlipCooldown = false
        return
    end
    local savedTracks = {}
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            savedTracks[#savedTracks + 1] = {
                track = track,
                time = track.TimePosition,
                speed = track.Speed,
                weight = track.WeightCurrent
            }
            track:Stop(0)
        end
    end
    local animateWasEnabled = animate and animate.Enabled
    if animate then
        animate.Enabled = false
    end
    local oldAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    local duration = 0.45
    local steps = 120
    local startCFrame = hrp.CFrame
    local forwardVector = startCFrame.LookVector
    local upVector = Vector3.new(0, 1, 0)
    task.spawn(function()
        local startTime = tick()
        for i = 1, steps do
            if not character.Parent or humanoid.Health <= 0 then
                break
            end
            local t = i / steps
            local height = 4 * (t - t ^ 2) * 10
            local nextPos = startCFrame.Position + forwardVector * (35 * t) + upVector * height
            local rotation = startCFrame.Rotation * CFrame.Angles(-math.rad(i * (360 / steps)), 0, 0)
            hrp.CFrame = CFrame.new(nextPos) * rotation
            local elapsedTime = tick() - startTime
            local expectedTime = (duration / steps) * i
            local waitTime = expectedTime - elapsedTime
            if waitTime > 0 then
                task.wait(waitTime)
            end
        end
        if character.Parent and humanoid.Health > 0 then
            hrp.CFrame = CFrame.new(startCFrame.Position + forwardVector * 35)
        end
        if animator then
            for _, saved in ipairs(savedTracks) do
                local newTrack = animator:LoadAnimation(saved.track.Animation)
                newTrack:Play()
                newTrack:AdjustSpeed(saved.speed)
                newTrack.TimePosition = saved.time
            end
        end
        if animate and animateWasEnabled then
            animate.Enabled = true
        end
        if humanoid then
            humanoid.AutoRotate = oldAutoRotate
        end
        FlipCooldown = false
    end)
end
